{
  "name": "obsidian-graph-ng",
  "version": "0.5.0",
  "description": "Ontology-neutral, declared graph projections for Obsidian",
  "author": "cybersader",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "bun test tests/core.test.ts tests/adapter.test.ts tests/gates.test.ts tests/pipeline.test.ts tests/declaration-v2.test.ts tests/renderer.test.ts tests/view-lifecycle.test.ts tests/contribution-page.test.ts tests/layout.test.ts tests/explore.test.ts tests/expr.test.ts",
    "fixture": "bun scripts/generate.ts",
    "bench": "bun scripts/benchmark.ts",
    "project": "bun scripts/project.ts",
    "e2e": "wdio run wdio.conf.mts",
    "licenses": "node scripts/check-licenses.mjs",
    "bench:browser": "bun scripts/browser-benchmark.ts",
    "gates": "node scripts/gates.mjs",
    "gates:fast": "node scripts/gates.mjs --fast",
    "audit:history": "node scripts/audit-history.mjs",
    "release:local": "node scripts/release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "bench:layout": "bun scripts/layout-benchmark.ts",
    "bench:expressions": "bun scripts/expression-benchmark.ts",
    "docs:expressions": "bun scripts/expression-reference.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/node": "20.19.40",
    "@types/mocha": "10.0.10",
    "@wdio/cli": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "esbuild": "0.28.2",
    "obsidian": "1.12.3",
    "typescript": "5.9.3",
    "wdio-obsidian-service": "2.4.0",
    "wdio-obsidian-reporter": "2.4.0",
    "playwright": "1.65.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": []
}
